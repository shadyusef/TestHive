# Copy to .env (never commit .env)
# Plain KEY=value lines only (no spaces around =). Every variable is passed to the Maestro flows.
APP_ID=com.example.app
# Name of the environment under test (staging, uat, ...), recorded with every run
TEST_ENV=staging
# iOS bundle id, used when PLATFORM=ios (leave empty if it equals APP_ID)
IOS_APP_ID=
BASE_URL=https://staging.example.com
API_BASE_URL=https://api.staging.example.com
# A test account of the product under test (web Explore logs in with it; Maestro flows get both)
TEST_USER=
TEST_USER_PASSWORD=change-me
ANDROID_DEVICE_ID=
IOS_DEVICE_ID=
