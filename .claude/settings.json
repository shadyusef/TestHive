{
  "permissions": {
    "allow": [
      "Bash(bash scripts/*)",
      "Bash(maestro *)",
      "Bash(adb *)",
      "Bash(newman *)",
      "Bash(npx playwright *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Bash(git push)",
      "Bash(git push *)",
      "Bash(bash scripts/mask.sh suggest *)",
      "Bash(bash scripts/mask.sh review *)",
      "Bash(bash scripts/hive.sh mask suggest *)",
      "Bash(bash scripts/hive.sh mask review *)",
      "Read(./.mask-map.json)",
      "Read(./.mask-terms)",
      "Bash(bash scripts/studio.sh*)",
      "Bash(bash scripts/hive.sh studio*)",
      "Read(./.private-names)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/hooks/run.sh\" guard_records",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/hooks/run.sh\" check_edit",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
