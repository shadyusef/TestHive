# Keep line endings stable on every OS. Bash breaks on CRLF, and a CRLF .env corrupts values.
* text=auto
*.sh text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.md text eol=lf
*.csv text eol=lf
*.json text eol=lf
*.ts text eol=lf
*.example text eol=lf
*.png binary
*.cmd text eol=crlf
*.bat text eol=crlf
*.py text eol=lf
*.mp4 binary
*.txt text eol=lf
*.xml text eol=lf
VERSION text eol=lf
*.ps1 text eol=crlf
*.html text eol=lf
*.mjs text eol=lf
*.js text eol=lf
